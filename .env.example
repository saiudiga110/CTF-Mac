# â”€â”€ Database â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
MYSQL_ROOT_PASSWORD=ctfd
MYSQL_PASSWORD=ctfd

# â”€â”€ CTFd admin account (created automatically on first boot) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
ADMIN_NAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe2024!

# â”€â”€ Shared HMAC secret (must be identical in CTFd plugin and vbank container) â”€
# Flags: LYD{hmac_sha256(FLAG_SECRET, "{owner_id}:{flag_key}")[:24]}
# Change this before a real event. All team flags are derived from this.
FLAG_SECRET=change_this_to_a_random_secret

# â”€â”€ CTFd Flask secret key (random string, keep private) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
CTFD_SECRET_KEY=change_this_to_a_random_string

# â”€â”€ JWT secret for vBank API portal challenge â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
JWT_SECRET=change_this_to_a_random_string

# â”€â”€ Host IP â€” set automatically by start.sh / start.ps1 â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Leave as 127.0.0.1; the startup script overwrites this with your real LAN IP.
HOST_IP=127.0.0.1

# Primary LAN hostname served by dnsmasq and nginx.
CTF_HOSTNAME=lloydsctf.lab

# Public host-port ranges for per-user instances.
# Open these TCP ranges on the host firewall for LAN players.
TARGET_PORT_RANGE_START=20000
TARGET_PORT_RANGE_END=20999
KALI_PORT_RANGE_START=21000
KALI_PORT_RANGE_END=21999

# â”€â”€ CTF branding â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
CTF_NAME=Lloyds CTF

# â”€â”€ Subdomain routing â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
LAB_DOMAIN=lab

# â”€â”€ Production (used by start.ps1 -Production / start.sh --production) â”€â”€â”€â”€â”€â”€â”€â”€
# Gunicorn workers inside CTFd. 3 is a good LAN-event default.
WORKERS=3
PRODUCTION=0


# Cross-platform Instance Manager / worker agent.
# Generate a strong random value and use the same value on the manager and every worker machine.
INSTANCE_MANAGER_SECRET=change_this_to_a_random_instance_manager_secret
INSTANCE_MANAGER_URL=http://instance-manager:8088

# local = current single-host Docker socket behavior.
# instance_manager = CTFd asks the Instance Manager to schedule instances.
CTFD_TARGET_ORCHESTRATOR=local

# allocate = manager returns placement only.
# worker = manager calls the selected worker agent to create/delete containers.
INSTANCE_MANAGER_DEPLOY_MODE=allocate
CTFD_TARGET_IMAGE_PLATFORM=multi
CTFD_TARGET_INSTANCE_DISK_MB=256

# Optional worker overrides. The worker agent auto-detects these where it can,
# but Docker Desktop/WSL2 resource caps may need explicit confirmation.
# The startup command launches a local worker agent automatically in production mode.
# WORKER_ID=
# WORKER_PUBLIC_IP=
# WORKER_RUNTIME_CPUS=
# WORKER_RUNTIME_RAM_MB=
# WORKER_CONTAINER_LIMIT=80
# WORKER_TARGET_PORT_START=20000
# WORKER_TARGET_PORT_END=20999
# WORKER_EXTRA_PLATFORMS=linux/amd64-emulated
# WORKER_ASSUME_AMD64_EMULATION=0
# WORKER_LABELS=site=lan-room-a,role=worker
# Scheduled Kali/Pwn Machine resource profile. Image is unchanged; these are runtime limits.
KALI_MEM_LIMIT=1280m
KALI_CPU_QUOTA=50000
KALI_DISK_MB=1536
KALI_PIDS_LIMIT=512
KALI_SHM_SIZE=256m
KALI_IMAGE_PLATFORM=multi
# Optional Kali image build toggles. Defaults keep browser, terminal, Burp, nmap, hydra, john.
KALI_INCLUDE_EXTRA_TOOLS=0
KALI_INCLUDE_HASHCAT=0
KALI_INCLUDE_WORDLISTS=0
